+static struct apk_package *apk_db_pkg_add_secondary_duplicate( struct apk_database *db, struct apk_package *base, struct apk_installed_package *secondary_ipkg, size_t digest_len)
+{
+	struct apk_package *copy;
+	struct apk_db_dir_instance *diri;
+
+	if (base == NULL || secondary_ipkg == NULL ||
+	    digest_len < APK_DIGEST_LENGTH_SHA1)
+		return NULL;
+
+	copy = apk_balloc_new_extra(&db->ba_pkgs, struct apk_package, digest_len);
+	if (copy == NULL)
+		return NULL;
+	memcpy(copy, base, sizeof(*copy));
+	memcpy(copy->digest, base->digest, digest_len);
+	memset(&copy->hash_node, 0, sizeof(copy->hash_node));
+	memset(&copy->ss, 0, sizeof(copy->ss));
+	copy->ipkg = secondary_ipkg;
+	copy->ipkg->pkg = copy;
+	copy->layer = APK_DB_LAYER_SECONDARY;
+	copy->seen = 0;
+	copy->marked = 0;
+	copy->foreach_genid = 0;
+	apk_array_foreach_item(diri, copy->ipkg->diris)
+		diri->pkg = copy;
+
+	apk_provider_array_add(&copy->name->providers, APK_PROVIDER_FROM_PACKAGE(copy));
+	copy->name->providers_sorted = 0;
+	apk_array_foreach(dep, copy->provides) {
+		apk_provider_array_add(&dep->name->providers, APK_PROVIDER_FROM_PROVIDES(copy, dep));
+		dep->name->providers_sorted = 0;
+	}
+	apk_package_array_add(&db->secondary_packages, copy);
+	return copy;
+}
