+static int apk_db_read_secondary_root(struct apk_database *db, const char *path)
+{
+	struct stat secondary_st, root_st;
+	int root_fd = -1, db_fd = -1, lock_fd = -1, r;
+
+	root_fd = open(path, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+	if (root_fd < 0) return -errno;
+	if (fstat(root_fd, &secondary_st) < 0 || fstat(db->root_fd, &root_st) < 0) {
+		r = -errno;
+		goto done;
+	}
+	if (secondary_st.st_dev == root_st.st_dev && secondary_st.st_ino == root_st.st_ino) {
+		r = -EINVAL;
+		goto done;
+	}
+	db_fd = openat(root_fd, "lib/apk/db", O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+	if (db_fd < 0) {
+		r = -errno;
+		goto done;
+	}
+
+	lock_fd = openat(db_fd, "lock", O_RDONLY | O_CLOEXEC);
+	if (lock_fd >= 0) {
+		if (flock(lock_fd, LOCK_SH | LOCK_NB) < 0) {
+			r = -errno;
+			goto done;
+		}
+	} else if (errno != ENOENT) {
+		r = -errno;
+		goto done;
+	}
+
+	r = apk_db_fdb_read(db, apk_istream_from_file(db_fd, "installed"), APK_REPO_DB_INSTALLED, APK_DB_LAYER_SECONDARY);
+	if (r == 0)
+		db->active_layers |= BIT(APK_DB_LAYER_SECONDARY);
+done:
+	if (lock_fd >= 0) close(lock_fd);
+	if (db_fd >= 0) close(db_fd);
+	if (root_fd >= 0) close(root_fd);
+	return r;
+}
