+static int apk_db_read_secondary_root(struct apk_database *db)
+{
+	struct apk_ctx *ac = db->ctx;
+	int root_fd = -1, db_fd = -1, lock_fd = -1;
+	int r = 0;
+	struct stat primary_stat, secondary_stat;
+
+	if (ac->secondary_root == NULL) return 0;
+
+	root_fd = openat(AT_FDCWD, ac->secondary_root, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+	if (root_fd < 0) return -errno;
+	if (fstat(db->root_fd, &primary_stat) < 0 || fstat(root_fd, &secondary_stat) < 0) {
+		r = -errno;
+		goto done;
+	}
+	if (primary_stat.st_dev == secondary_stat.st_dev && primary_stat.st_ino == secondary_stat.st_ino) {
+		r = -EINVAL;
+		goto done;
+	}
+	db_fd = openat(root_fd, "lib/apk/db", O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+	if (db_fd < 0) {
+		r = -errno; goto done;
+	}
+
+	lock_fd = openat(db_fd, "lock", O_RDONLY | O_CLOEXEC);
+	if (lock_fd < 0 && errno != ENOENT) {
+		r = -errno;
+		goto done;
+	}
+	if (lock_fd >= 0 && flock(lock_fd, LOCK_SH | LOCK_NB) < 0) {
+		r = -errno;
+		goto done;
+	}
+
+	if (!(ac->open_flags & APK_OPENF_NO_INSTALLED)) {
+		r = apk_db_fdb_read(db, apk_istream_from_file(db_fd, "installed"), APK_REPO_DB_INSTALLED, APK_DB_LAYER_SECONDARY);
+		if (r == -ENOENT) r = 0;
+		if (r) goto done;
+	}
+
+	db->active_layers |= BIT(APK_DB_LAYER_SECONDARY);
+
+done:
+	if (lock_fd >= 0) close(lock_fd);
+	if (db_fd >= 0) close(db_fd);
+	if (root_fd >= 0) close(root_fd);
+	return r;
+}
