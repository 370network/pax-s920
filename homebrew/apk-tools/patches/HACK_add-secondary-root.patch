+int apk_ctx_use_secondary_root(struct apk_ctx *ac, const char *path)
+{
+	char *copy;
+
+	if (path == NULL || path[0] == 0)
+		return -EINVAL;
+	copy = apk_balloc_cstr(&ac->ba, APK_BLOB_STR(path));
+	if (copy == NULL)
+		return -ENOMEM;
+	apk_string_array_add(&ac->secondary_repository_list, copy);
+	return 0;
+}
