+typedef struct _kevdevTouch {
+	int pending_x, pending_y;
+	Bool have_x, have_y;
+	Bool down;
+} KevdevTouch;
+
+static void EvdevRead(int fd, void *closure)
+{
+	KdMouseInfo *mi = closure;
+	KevdevTouch *kt = mi->driver;
+	struct input_event ev;
+	ssize_t n;
+
+	while ((n = read(fd, &ev, sizeof(ev))) == sizeof(ev)) {
+		switch (ev.type) {
+		case EV_ABS:
+			switch (ev.code) {
+			case ABS_X:
+			case ABS_MT_POSITION_X:
+				kt->pending_x = ev.value;
+				kt->have_x = TRUE;
+				break;
+			case ABS_Y:
+			case ABS_MT_POSITION_Y:
+				kt->pending_y = ev.value;
+				kt->have_y = TRUE;
+				break;
+			}
+			break;
+		case EV_KEY:
+			if (ev.code == BTN_TOUCH || ev.code == BTN_LEFT)
+				kt->down = ev.value ? TRUE : FALSE;
+			break;
+		case EV_SYN:
+			if (ev.code != SYN_REPORT)
+				break;
+			if (kt->have_x && kt->have_y && screenInfo.numScreens > 0) {
+				unsigned long flags = kt->down ? KD_BUTTON_1 : 0;
+				KdEnqueueMouseEvent(mi, flags, kt->pending_x, kt->pending_y);
+			}
+			break;
+		}
+	}
+}
+
+static Bool EvdevInit(KdMouseInfo * mi, int fd)
+{
+	KevdevTouch *kt;
+
+	kt = calloc(1, sizeof(KevdevTouch));
+	if (!kt)
+		return FALSE;
+
+	mi->driver = kt;
+	return TRUE;
+}
+
